# ============================================================
# LoanOps — Environment Configuration Example
# Copy this file to .env and REPLACE every REPLACE-ME value.
# NEVER commit real secrets to version control!
# ============================================================

# 1. PostgreSQL Connection Strings (Supabase / RDS / Neon)
# DATABASE_URL: used by the application at runtime (via PgBouncer in production)
DATABASE_URL="postgresql://user:password@db.example.com:6543/loanops?pgbouncer=true"
# DIRECT_URL: used by Prisma migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://user:password@db.example.com:5432/loanops"
# DATABASE_URL_TEST: REQUIRED for seed script and E2E tests. Must differ from DATABASE_URL.
DATABASE_URL_TEST="postgresql://user:password@db.example.com:5432/loanops_test"

# 2. Cryptographic & Session Secrets (generate your own with: openssl rand -hex 32)
# SESSION_SECRET: signs session cookies (min 32 chars, MUST be unique per env)
# REPLACE-ME — the value below is a published example, NOT a usable secret.
SESSION_SECRET="98812d8a1e1e95890c471c8d41bf2c219a23956b00ebf64139aceb51a3cc5cc2"
# PII_ENCRYPTION_KEY: AES-256-GCM key material for PAN/bank account encryption.
# Must be EXACTLY 64 hex characters (0-9, a-f) = 32 bytes, so a copied .env
# passes the format check in src/lib/server/env.ts.
# REPLACE-ME — generate your own with: openssl rand -hex 32
PII_ENCRYPTION_KEY="95e55c5a934b7a43dcb7be7456b12e761813f02e40c7a9861ab833eb327a09e1"
# PII_ENCRYPTION_KEY_PREVIOUS: previous key for zero-downtime rotation (optional)
PII_ENCRYPTION_KEY_PREVIOUS=""
# AADHAAR_HASH_PEPPER: HMAC-SHA256 pepper for Aadhaar hash (min 32 chars, NEVER rotate)
AADHAAR_HASH_PEPPER="replace-with-a-long-random-pepper-that-you-never-rotate-min32chars"
# PAYMENT_WEBHOOK_SECRET: HMAC for verifying online payment webhooks.
# REQUIRED in production when ENABLE_ONLINE_PAYMENTS="true" (env.ts enforces this).
# REPLACE-ME — generate your own with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET="369035980637839d9aa2bd3ed19cce22746b9b24912ddd743d05e3889dc8d1d7"

# 3. Runtime & Application URL
NODE_ENV="development"
# NEXT_PUBLIC_APP_URL: must be https:// in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# COOKIE_SECURE: MUST be "true" in production (HTTPS) — env.ts enforces this
COOKIE_SECURE="false"
# SESSION_IDLE_TIMEOUT_MINUTES: how long an idle session stays valid
SESSION_IDLE_TIMEOUT_MINUTES="120"
# TRUST_PROXY: set to "true" ONLY when a trusted reverse proxy (e.g. Caddy)
# in front of the app sets forwarding headers. When false/unset, x-forwarded-for
# is ignored for rate limiting because clients can spoof it.
TRUST_PROXY="false"
# TRUSTED_PROXY_HEADER: which proxy header to trust for client IP when a proxy
# is trusted (e.g. "x-forwarded-for", "cf-connecting-ip"). Setting this also
# enables proxy trust for that header. Leave empty when there is no proxy.
TRUSTED_PROXY_HEADER=""
# CRON_SECRET: shared secret for scheduled-job endpoints (e.g. overdue
# marking / reconciliation jobs invoked by an external scheduler).
# REPLACE-ME — set a long random value in every deployed environment.
CRON_SECRET=""

# 4. Feature Flags
# ENABLE_ONLINE_PAYMENTS: offline cash is primary; keep disabled unless you have a gateway
ENABLE_ONLINE_PAYMENTS="false"
# ALLOW_PROD_SEED: allow seed script to run in production (extremely dangerous)
ALLOW_PROD_SEED="false"

# 5. Legal, Regulatory & DPDP Act 2023 Compliance Configuration (India Lending)
# TODO: Replace placeholders after qualified legal review and RBI NBFC / Regulated Entity registration
NEXT_PUBLIC_COMPANY_NAME="Sterling Lending Operations (Technology Platform)"
NEXT_PUBLIC_COMPANY_CIN="[CIN PLACEHOLDER — SET NEXT_PUBLIC_COMPANY_CIN]"
NEXT_PUBLIC_RBI_REG_NUMBER="[REGULATED ENTITY / NBFC LICENCE PLACEHOLDER — SET NEXT_PUBLIC_RBI_REG_NUMBER]"
NEXT_PUBLIC_COMPANY_ADDRESS="Level 8, Maker Maxity, Bandra Kurla Complex, Mumbai, Maharashtra 400051, India"
NEXT_PUBLIC_SUPPORT_EMAIL="support@loanops.in"
NEXT_PUBLIC_SUPPORT_PHONE="+91-22-4000-0000"
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME="[Designated Grievance Officer — Configure in Env]"
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL="grievance@loanops.in"
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE="+91-22-4000-0001"

# 6. Optional: Abuse Protection (CAPTCHA & Caching)
TURNSTILE_SECRET_KEY=""
HCAPTCHA_SECRET_KEY=""
# Upstash Redis — used for caching (src/lib/redis.ts). NOTE: rate limiting is
# in-memory per-instance (src/lib/server/rate-limit.ts); Redis does NOT make
# rate limits distributed.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# 7. Optional: Error Monitoring Webhook (Sentry / Datadog / PagerDuty)
ERROR_MONITORING_WEBHOOK_URL=""
SENTRY_WEBHOOK_URL=""

# 8. Seed Script Passwords (development / CI only — ALL MUST BE SET BY YOU)
# There are NO usable default seed passwords. Set strong, unique values here
# before running scripts/seed.ts; never reuse them outside local dev / CI.
SEED_OWNER_PASSWORD=""
SEED_AGENT_PASSWORD=""
SEED_AGENT2_PASSWORD=""
SEED_CANDIDATE_PASSWORD=""
