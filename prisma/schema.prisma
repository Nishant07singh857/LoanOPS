// Loan Ops Platform - Comprehensive Prisma Schema
// Multi-tenant architecture with Owner, Agent, Candidate portals

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CORE: ORGANIZATION & USERS (Multi-Tenant)
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  candidates               Candidate[]
  applications             Application[]
  loans                    Loan[]
  agents                   AgentProfile[]
  agreements               AgreementTemplate[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  supportTickets           SupportTicket[]
  ledgerEntries            LedgerEntry[]
  qrLinks                  QrLink[]
  payments                 Payment[]
  collectionTasks          CollectionTask[]
  webhookEvents            WebhookEvent[]
  reconciliationRuns       ReconciliationRun[]
  reconciliationExceptions ReconciliationException[]
  aiInsights               AiInsight[]
  consentRecords           ConsentRecord[]
  dataSubjectRequests      DataSubjectRequest[]
}

enum UserRole {
  OWNER
  AGENT
  CANDIDATE
}

model User {
  id                  String    @id @default(cuid())
  organizationId      String
  email               String    @unique
  passwordHash        String
  name                String
  phone               String?
  role                UserRole
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  totpSecret          String?
  totpEnabled         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  agentProfile         AgentProfile?
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  consentRecords       ConsentRecord[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  qrLinks              QrLink[]
  paymentRecords       Payment[]             @relation("PaymentRecordedBy")
  paymentVerifications Payment[]             @relation("PaymentVerifiedBy")
  followUps            FollowUp[]
  ptps                 Ptp[]
  escalations          Escalation[]
  disbursements        Disbursement[]
  refunds              Refund[]
  corrections          FinancialCorrection[]

  @@index([organizationId])
  @@index([role])
  @@index([organizationId, role])
}

model Session {
  id           String    @id @default(cuid())
  token        String    @unique
  tokenPrefix  String? // first 16 chars of the session token, indexed for fast lookup
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  ipAddr       String?
  userAgent    String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([tokenPrefix])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Optional: candidate userId if candidate is also a portal user
// Candidate does not necessarily have a User record unless they sign in.

model AgentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  employeeCode   String?
  zone           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  candidates   Candidate[]
  tasks        CollectionTask[] @relation("AssignedAgent")

  @@index([organizationId])
}

// ============================================================
// CANDIDATES (Borrowers)
// ============================================================

model Candidate {
  id                  String          @id @default(cuid())
  organizationId      String
  userId              String?         @unique // link to User for candidate portal login
  fullName            String
  mobile              String
  secondaryMobile     String?
  email               String?
  dob                 DateTime?
  address             String?
  occupation          String?
  employer            String?
  monthlyIncome       Int? // in paise
  existingObligations Int? // in paise
  bankName            String?
  bankAccount         String?
  bankIfsc            String?
  upiId               String?
  aadhaarMasked       String?
  aadhaarLast4        String?
  aadhaarHash         String?
  panMasked           String?
  assignedAgentId     String?
  claimCodeHash       String?
  claimCodeExpiresAt  DateTime?
  status              CandidateStatus @default(ACTIVE)
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  assignedAgent       AgentProfile?        @relation(fields: [assignedAgentId], references: [id])
  applications        Application[]
  loans               Loan[]
  kycDocs             KycDocument[]
  documents           Document[]
  payments            Payment[]
  followUps           FollowUp[]
  ptps                Ptp[]
  escalations         Escalation[]
  collectionTasks     CollectionTask[]
  supportTickets      SupportTicket[]
  notifications       Notification[]
  consentRecords      ConsentRecord[]
  dataSubjectRequests DataSubjectRequest[]

  @@index([organizationId])
  @@index([mobile])
  @@index([assignedAgentId])
}

enum CandidateStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

// ============================================================
// APPLICATIONS (Loan Applications)
// ============================================================

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  INFORMATION_REQUESTED
}

enum InterestType {
  PERCENTAGE
  FIXED
  NONE
}

enum RepaymentFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Application {
  id                  String             @id @default(cuid())
  organizationId      String
  candidateId         String
  qrLinkId            String?            @unique
  applicationNumber   String             @unique
  // Loan configuration
  principalAmount     Int // in paise
  currency            String             @default("INR")
  purpose             String
  interestType        InterestType
  interestRate        Int? // basis points (1% = 100)
  fixedInterest       Int? // in paise
  frequency           RepaymentFrequency
  tenureCount         Int // number of units
  installments        Int
  firstDueDate        DateTime
  processingFee       Int? // in paise
  otherFees           Int? // in paise
  totalRepayable      Int? // in paise (preview, backend authoritative)
  installmentAmount   Int? // in paise (preview)
  finalDueDate        DateTime?
  status              ApplicationStatus  @default(DRAFT)
  // KYC snapshot
  kycAadhaar          String?
  kycPan              String?
  kycStatus           String? // PENDING/VERIFIED/REJECTED
  // Agreement
  agreementTemplateId String?
  agreementVersion    String?
  agreementAcceptedAt DateTime?
  agreementSnapshot   Json?
  // Review
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNotes         String?
  rejectionReason     String?
  infoRequested       String?
  // Audit
  submittedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  candidate    Candidate    @relation(fields: [candidateId], references: [id])
  qrLink       QrLink?      @relation(fields: [qrLinkId], references: [id])
  loan         Loan?

  @@index([organizationId])
  @@index([candidateId])
  @@index([status])
  @@index([organizationId, status])
}

// ============================================================
// QR / SECURE LINKS (Onboarding)
// ============================================================

model QrLink {
  id               String              @id @default(cuid())
  organizationId   String
  token            String              @unique
  // Pre-configured loan parameters
  prePrincipal     Int? // in paise
  preInterestType  InterestType?
  preInterestRate  Int?
  preFixedInterest Int?
  preFrequency     RepaymentFrequency?
  preTenure        Int?
  preInstallments  Int?
  preFirstDueDate  DateTime?
  prePurpose       String?
  preProcessingFee Int?
  preOtherFees     Int?
  // Pre-configured Borrower details
  preFullName      String?
  preMobile        String?
  preAadhaar       String?
  prePan           String?

  createdById String
  // Meta
  expiresAt   DateTime?
  isRevoked   Boolean   @default(false)
  isUsed      Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  application  Application?

  @@index([organizationId])
  @@index([token])
}

// ============================================================
// AGREEMENTS
// ============================================================

model AgreementTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        String
  body           String // markdown / html
  effectiveDate  DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, version])
  @@index([organizationId])
}

// ============================================================
// LOANS
// ============================================================

enum LoanStatus {
  PENDING_DISBURSEMENT
  ACTIVE
  CLOSED
  DEFAULTED
  WRITTEN_OFF
}

model Loan {
  id                   String             @id @default(cuid())
  organizationId       String
  loanNumber           String             @unique
  candidateId          String
  applicationId        String?            @unique
  // Immutable term snapshot
  principalAmount      Int // paise
  interestType         InterestType
  interestRate         Int?
  fixedInterest        Int?
  frequency            RepaymentFrequency
  installments         Int
  firstDueDate         DateTime
  finalDueDate         DateTime
  processingFee        Int?
  otherFees            Int?
  totalRepayable       Int
  installmentAmount    Int
  termsSnapshot        Json
  status               LoanStatus         @default(PENDING_DISBURSEMENT)
  disbursedAt          DateTime?
  closedAt             DateTime?
  outstandingPrincipal Int                @default(0)
  outstandingInterest  Int                @default(0)
  outstandingFees      Int                @default(0)
  totalCollected       Int                @default(0)
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id])
  candidate       Candidate             @relation(fields: [candidateId], references: [id])
  application     Application?          @relation(fields: [applicationId], references: [id])
  schedule        Installment[]
  payments        Payment[]
  ptps            Ptp[]
  escalations     Escalation[]
  collectionTasks CollectionTask[]
  followUps       FollowUp[]
  disbursements   Disbursement[]
  refunds         Refund[]
  documents       Document[]
  corrections     FinancialCorrection[]

  @@index([organizationId])
  @@index([candidateId])
  @@index([status])
  @@index([organizationId, status])
}

enum InstallmentStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Installment {
  id                 String            @id @default(cuid())
  loanId             String
  installmentNumber  Int
  dueDate            DateTime
  openingPrincipal   Int // paise
  principalComponent Int
  interestComponent  Int
  feesComponent      Int
  totalDue           Int
  closingPrincipal   Int
  paidFees           Int               @default(0)
  paidInterest       Int               @default(0)
  paidPrincipal      Int               @default(0)
  paidAmount         Int               @default(0)
  status             InstallmentStatus @default(UPCOMING)
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNumber])
  @@index([loanId])
  @@index([status])
  @@index([dueDate])
  @@index([loanId, status])
  @@index([status, dueDate])
}

// ============================================================
// DISBURSEMENT
// ============================================================

enum DisbursementMethod {
  ONLINE
  OFFLINE
}

enum DisbursementStatus {
  INITIATED
  COMPLETED
  FAILED
  CANCELLED
}

model Disbursement {
  id            String             @id @default(cuid())
  loanId        String
  method        DisbursementMethod
  amount        Int // paise
  reference     String?
  notes         String?
  proofUrl      String?
  status        DisbursementStatus @default(INITIATED)
  initiatedById String
  initiatedAt   DateTime           @default(now())
  completedAt   DateTime?

  loan        Loan @relation(fields: [loanId], references: [id])
  initiatedBy User @relation(fields: [initiatedById], references: [id])

  // Partial unique index via raw SQL in migration (only one COMPLETED per loan)
  // Failed/cancelled retries are allowed.
  @@index([loanId])
}

// ============================================================
// PAYMENTS
// ============================================================

enum PaymentMethod {
  ONLINE_UPI
  ONLINE_NETBANKING
  ONLINE_CARD
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  INITIATED
  PENDING_VERIFICATION
  VERIFIED
  ALLOCATED
  FAILED
  REJECTED
}

model Payment {
  id                 String        @id @default(cuid())
  organizationId     String
  paymentNumber      String        @unique
  loanId             String
  candidateId        String
  method             PaymentMethod
  amount             Int // paise
  reference          String?
  proofUrl           String?
  status             PaymentStatus @default(INITIATED)
  idempotencyKey     String?       @unique
  providerEventId    String?       @unique
  // Allocation breakdown
  allocatedFees      Int           @default(0)
  allocatedInterest  Int           @default(0)
  allocatedPrincipal Int           @default(0)
  unallocated        Int           @default(0)
  allocatedAt        DateTime?
  recordedById       String?
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  receiptNumber      String?       @unique
  receiptUrl         String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  loan         Loan         @relation(fields: [loanId], references: [id])
  candidate    Candidate    @relation(fields: [candidateId], references: [id])
  recordedBy   User?        @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  verifiedBy   User?        @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@index([organizationId])
  @@index([loanId])
  @@index([candidateId])
  @@index([recordedById])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([loanId, status])
  @@index([organizationId, createdAt])
}

// ============================================================
// COLLECTIONS / TASKS / FOLLOW-UPS / PTP
// ============================================================

enum TaskStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model CollectionTask {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  loanId         String
  assignedToId   String?
  title          String
  description    String?
  amount         Int?
  dueDate        DateTime
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  outcome        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  candidate    Candidate     @relation(fields: [candidateId], references: [id])
  loan         Loan          @relation(fields: [loanId], references: [id])
  assignedTo   AgentProfile? @relation("AssignedAgent", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
}

enum ContactMethod {
  PHONE
  WHATSAPP
  IN_APP
  FIELD_VISIT
}

model FollowUp {
  id            String        @id @default(cuid())
  candidateId   String
  loanId        String?
  agentId       String
  contactDate   DateTime
  contactMethod ContactMethod
  outcome       String?
  notes         String?
  nextFollowUp  DateTime?
  createdAt     DateTime      @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])
  loan      Loan?     @relation(fields: [loanId], references: [id])
  agent     User      @relation(fields: [agentId], references: [id])

  @@index([candidateId])
  @@index([agentId])
}

enum PtpStatus {
  ACTIVE
  FULFILLED
  BROKEN
  CANCELLED
}

model Ptp {
  id             String    @id @default(cuid())
  candidateId    String
  loanId         String
  agentId        String
  promisedAmount Int // paise
  promiseDate    DateTime
  status         PtpStatus @default(ACTIVE)
  notes          String?
  fulfilledAt    DateTime?
  brokenAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
  loan      Loan      @relation(fields: [loanId], references: [id])
  agent     User      @relation(fields: [agentId], references: [id])

  @@index([candidateId])
  @@index([loanId])
  @@index([status])
}

enum EscalationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum EscalationReason {
  REPEATED_MISSED_PAYMENT
  BROKEN_PTP
  LONG_OVERDUE
  FAILED_CONTACT
  HIGH_OUTSTANDING
  OTHER
}

model Escalation {
  id              String           @id @default(cuid())
  candidateId     String
  loanId          String
  agentId         String
  reason          EscalationReason
  description     String?
  status          EscalationStatus @default(OPEN)
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
  loan      Loan      @relation(fields: [loanId], references: [id])
  agent     User      @relation(fields: [agentId], references: [id])

  @@index([candidateId])
  @@index([status])
}

// ============================================================
// FINANCE: LEDGER, REFUNDS, CORRECTIONS
// ============================================================

enum LedgerEntryType {
  DISBURSEMENT
  PAYMENT_PRINCIPAL
  PAYMENT_INTEREST
  PAYMENT_FEES
  REFUND
  CORRECTION
  REVERSAL
  FEE
}

model LedgerEntry {
  id             String          @id @default(cuid())
  organizationId String
  entryNumber    String          @unique
  type           LedgerEntryType
  debitAccount   String
  creditAccount  String
  amount         Int // paise
  description    String?
  reference      String?
  loanId         String?
  paymentId      String?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([reference])
  @@index([loanId])
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Refund {
  id            String       @id @default(cuid())
  loanId        String
  paymentId     String?
  amount        Int // paise
  reason        String
  status        RefundStatus @default(REQUESTED)
  initiatedById String
  processedAt   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  loan        Loan @relation(fields: [loanId], references: [id])
  initiatedBy User @relation(fields: [initiatedById], references: [id])

  @@index([loanId])
  @@index([paymentId])
  @@index([status])
}

enum CorrectionStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  APPLIED
}

model FinancialCorrection {
  id            String           @id @default(cuid())
  loanId        String
  paymentId     String?
  amount        Int? // paise
  requestedById String
  reason        String
  evidenceUrl   String?
  status        CorrectionStatus @default(REQUESTED)
  reviewedById  String?
  reviewNotes   String?
  appliedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  loan        Loan @relation(fields: [loanId], references: [id])
  requestedBy User @relation(fields: [requestedById], references: [id])
}

// ============================================================
// DOCUMENTS / KYC
// ============================================================

enum DocumentType {
  AADHAAR
  PAN
  ADDRESS_PROOF
  INCOME_PROOF
  BANK_PROOF
  BUSINESS_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Document {
  id             String         @id @default(cuid())
  organizationId String
  candidateId    String?
  loanId         String?
  type           DocumentType
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  status         DocumentStatus @default(PENDING)
  version        Int            @default(1)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  candidate Candidate? @relation(fields: [candidateId], references: [id])
  loan      Loan?      @relation(fields: [loanId], references: [id])

  @@index([candidateId])
  @@index([loanId])
}

model KycDocument {
  id            String    @id @default(cuid())
  candidateId   String
  aadhaarNumber String?
  panNumber     String?
  aadhaarUrl    String?
  panUrl        String?
  status        String    @default("PENDING") // PENDING/VERIFIED/REJECTED
  verifiedAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
}

// ============================================================
// NOTIFICATIONS & SUPPORT
// ============================================================

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  INFORMATION_REQUESTED
  AGREEMENT
  DISBURSEMENT
  PAYMENT_REMINDER
  PAYMENT_CONFIRMATION
  OVERDUE
  PTP_REMINDER
  RECEIPT
  NEW_ASSIGNMENT
  FOLLOW_UP
  PTP_DUE
  ESCALATION
  COLLECTION_REMINDER
  AI_INSIGHT
  RECONCILIATION_EXCEPTION
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  candidateId    String?
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  metadata       Json?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  candidate    Candidate?   @relation(fields: [candidateId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([candidateId])
}

enum SupportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

model SupportTicket {
  id             String        @id @default(cuid())
  organizationId String
  candidateId    String
  ticketNumber   String        @unique
  category       String
  subject        String
  description    String
  attachmentUrl  String?
  status         SupportStatus @default(OPEN)
  resolution     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  candidate    Candidate    @relation(fields: [candidateId], references: [id])

  @@index([organizationId])
  @@index([candidateId])
}

// ============================================================
// AUDIT LOG
// ============================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUBMIT
  VERIFY
  ALLOCATE
  DISBURSE
  REFUND
  RESTRUCTURE
  CORRECT
  REVOKE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  REVEAL_PII
  ROLE_CHANGE
  SETTINGS_CHANGE
  CONSENT_GIVEN
  DATA_REQUEST
  FILE_UPLOAD
  FILE_ACCESS
  PTP_CREATE
  PTP_UPDATE
  ESCALATE
  AGREE
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  action         AuditAction
  entityType     String
  entityId       String?
  description    String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
}

// ============================================================
// WEBHOOK EVENTS (idempotent provider event log)
// ============================================================

model WebhookEvent {
  id              String        @id @default(cuid())
  organizationId  String?
  provider        String // e.g. "razorpay", "stripe", "mock"
  eventId         String? // provider's event id
  signature       String?
  rawPayload      Json
  processed       Boolean       @default(false)
  processingError String?
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@unique([provider, eventId])
  @@index([organizationId])
}

// ============================================================
// RECONCILIATION
// ============================================================

model ReconciliationRun {
  id              String   @id @default(cuid())
  organizationId  String
  runNumber       String   @unique
  periodStart     DateTime
  periodEnd       DateTime
  totalExpected   Int
  totalCaptured   Int
  totalAllocated  Int
  exceptionsCount Int      @default(0)
  status          String   @default("COMPLETED") // COMPLETED / FAILED
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ReconciliationException {
  id              String    @id @default(cuid())
  organizationId  String
  runId           String?
  type            String // DUPLICATE_PROVIDER_EVENT, MISSING_PAYMENT, etc.
  severity        String // LOW / MEDIUM / HIGH
  description     String
  reference       String?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([runId])
}

// ============================================================
// AI INSIGHTS (advisory only — never authoritative)
// ============================================================

model AiInsight {
  id              String   @id @default(cuid())
  organizationId  String
  candidateId     String?
  loanId          String?
  signalType      String // PAYMENT_DELAY, REPEATED_MISSED_INSTALLMENTS, etc.
  level           String // LOW / MEDIUM / HIGH
  title           String
  reasons         Json
  suggestedAction String?
  isResolved      Boolean  @default(false)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([loanId])
  @@index([candidateId])
}

// ============================================================
// DPDP ACT 2023 & LENDING COMPLIANCE: CONSENTS & DATA REQUESTS
// ============================================================

model ConsentRecord {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  candidateId    String?
  applicationId  String?
  consentType    String // DATA_PROCESSING, KYC_AADHAAR, CREDIT_CHECK, COMMUNICATION, TERMS_PRIVACY, KFS_DISCLOSURE
  policyVersion  String   @default("2026.1")
  granted        Boolean  @default(true)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  candidate    Candidate?   @relation(fields: [candidateId], references: [id])

  @@index([organizationId])
  @@index([candidateId])
  @@index([userId])
  @@index([applicationId])
}

model DataSubjectRequest {
  id             String    @id @default(cuid())
  organizationId String
  candidateId    String
  userId         String?
  requestType    String // EXPORT, DELETION, CORRECTION, WITHDRAW_CONSENT
  status         String    @default("PENDING") // PENDING, COMPLETED, REJECTED_LEGAL_RETENTION
  reason         String?
  reviewNotes    String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  candidate    Candidate    @relation(fields: [candidateId], references: [id])

  @@index([organizationId])
  @@index([candidateId])
  @@index([status])
}

